[Unit]
Description=Outdoor fitness account independent daily publishing
After=network-online.target xhs-web.service channel.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/xhs
Environment=CONFIG_FILE=/home/ubuntu/leo-project/xhs/.local/runtime.yaml
ExecStart=/home/ubuntu/leo-project/xhs/.venv/bin/python -m backend.app.services.content_automation --config /home/ubuntu/leo-project/xhs/.local/outdoor-automation.json
Restart=on-failure
RestartSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
